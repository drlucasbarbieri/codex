// =============================================================================
// ABSORCAO POR AGRESSAO + VPIN  -  versao NTSL para o Editor de Estrategias do Profit
// Adaptacao da estrategia OFI/VPIN em Python para barras do Profit.
//
// Grafico recomendado: WIN (contrato atual), periodo de 1 minuto.
// Quantidade de contratos: defina na aba de execucao/automacao do Profit.
// Use primeiro em BACKTEST e depois no SIMULADOR antes de qualquer conta real.
//
// Diferencas para a versao Python (limites da NTSL):
// - OFI exato precisa do book tick a tick, que nao existe no historico da NTSL.
//   Aqui a absorcao e medida assim: agressao forte de um lado (saldo de agressao
//   da barra) e o preco NAO cede (variacao do fechamento a favor).
// - VPIN aproximado por barras: soma |agressao compradora - vendedora| dividida
//   pelo volume agredido total das ultimas JanelaVPIN barras do dia.
// - Limiares sao relativos (z-score em relacao a media exponencial), como no
//   modo "percentile" da versao Python. O z-score e testado comparando quadrados,
//   sem usar raiz quadrada.
// - Resultado do dia e estimado pela propria estrategia (preco do stop/alvo ou
//   abertura da barra seguinte) apenas para o limite de perda diaria.
// =============================================================================
input
  SpanEstatistica(100);        // barras da media/variancia exponencial
  JanelaVPIN(30);              // barras do VPIN aproximado (recomeca a cada dia)
  DeltaZMin(1.5);              // forca minima da agressao contraria (z, >= 0)
  RespostaZMin(0.0);           // resposta minima do preco a favor (z, >= 0)
  VPINZMin(0.5);               // VPIN acima da propria media (z, >= 0)
  StopPontos(150);             // stop em pontos a partir do preco de entrada
  AlvoPontos(225);             // alvo em pontos a partir do preco de entrada
  FolgaStopPontos(50);         // folga do preco limite da ordem stop
  MaxOperacoesDia(4);
  PerdaMaxDiaReais(600.0);     // para de abrir operacoes ao atingir esta perda estimada
  ValorPonto(0.20);            // WIN: R$ 0,20 por ponto por contrato
  Contratos(1);                // mesmo numero da aba de execucao (so para o calculo de perda)
  CustoPorContratoReais(5.5);  // corretagem + slippage estimado, ida e volta
  HoraInicio(905);
  HoraUltimaEntrada(1645);
  HoraZeragem(1700);
  UsarTendencia(false);        // true = exige MACD e T3 a favor
  PeriodoT3(5);
  FatorT3(0.7);

var
  iniciado : Boolean;
  barrasDia : Integer;
  operacoesDia : Integer;
  resultadoDia : Float;
  posAnterior : Integer;
  saidaMercado : Boolean;
  entradaAtual : Float;
  stopAtual : Float;
  alvoAtual : Float;
  saida : Float;
  agrCompra : Float;
  agrVenda : Float;
  delta : Float;
  retorno : Float;
  i : Integer;
  dif : Float;
  somaDesb : Float;
  somaVol : Float;
  vpin : Float;
  alfa : Float;
  nObs : Integer;
  nVpin : Integer;
  mDelta : Float;
  vDelta : Float;
  mRet : Float;
  vRet : Float;
  mVpin : Float;
  vVpin : Float;
  dd : Float;
  dr : Float;
  dv : Float;
  deltaVendaForte : Boolean;
  deltaCompraForte : Boolean;
  respostaAlta : Boolean;
  respostaBaixa : Boolean;
  vpinAlto : Boolean;
  sinalCompra : Boolean;
  sinalVenda : Boolean;
  ema12 : Float;
  ema26 : Float;
  macdLinha : Float;
  macdSinal : Float;
  histMacd : Float;
  k : Float;
  a : Float;
  c1 : Float;
  c2 : Float;
  c3 : Float;
  c4 : Float;
  e1 : Float;
  e2 : Float;
  e3 : Float;
  e4 : Float;
  e5 : Float;
  e6 : Float;
  t3 : Float;

begin
  // ---------- 1. Inicializacao e troca de dia ----------
  if not iniciado then
  begin
    iniciado := true;
    nObs := 0;
    nVpin := 0;
    posAnterior := 0;
    saidaMercado := false;
    ema12 := Close;
    ema26 := Close;
    macdSinal := 0;
    e1 := Close;
    e2 := Close;
    e3 := Close;
    e4 := Close;
    e5 := Close;
    e6 := Close;
  end;

  if Date <> Date[1] then
  begin
    barrasDia := 0;
    operacoesDia := 0;
    resultadoDia := 0;
  end;
  barrasDia := barrasDia + 1;

  // ---------- 2. Resultado estimado da operacao encerrada nesta barra ----------
  if (posAnterior = 1) and (not IsBought) then
  begin
    if saidaMercado then
      saida := Open
    else if Open <= stopAtual then
      saida := Open
    else if Low <= stopAtual then
      saida := stopAtual
    else if High >= alvoAtual then
      saida := alvoAtual
    else
      saida := Close;
    resultadoDia := resultadoDia + ((saida - entradaAtual) * ValorPonto - CustoPorContratoReais) * Contratos;
  end;

  if (posAnterior = -1) and (not IsSold) then
  begin
    if saidaMercado then
      saida := Open
    else if Open >= stopAtual then
      saida := Open
    else if High >= stopAtual then
      saida := stopAtual
    else if Low <= alvoAtual then
      saida := alvoAtual
    else
      saida := Close;
    resultadoDia := resultadoDia + ((entradaAtual - saida) * ValorPonto - CustoPorContratoReais) * Contratos;
  end;

  // ---------- 3. Fluxo de agressao da barra ----------
  agrCompra := AgressionVolBuy;
  agrVenda := AgressionVolSell;
  delta := agrCompra - agrVenda;
  retorno := Close - Close[1];

  // ---------- 4. VPIN aproximado (so com barras do dia) ----------
  vpin := -1;
  if barrasDia >= JanelaVPIN then
  begin
    somaDesb := 0;
    somaVol := 0;
    for i := 0 to JanelaVPIN - 1 do
    begin
      dif := agrCompra[i] - agrVenda[i];
      if dif < 0 then
        dif := -1.0 * dif;
      somaDesb := somaDesb + dif;
      somaVol := somaVol + agrCompra[i] + agrVenda[i];
    end;
    if somaVol > 0 then
      vpin := somaDesb / somaVol;
  end;

  // ---------- 5. Forca relativa (z-score comparando quadrados) ----------
  dd := delta - mDelta;
  dr := retorno - mRet;
  deltaVendaForte := (nObs >= 5) and (dd < 0) and (dd * dd >= DeltaZMin * DeltaZMin * vDelta);
  deltaCompraForte := (nObs >= 5) and (dd > 0) and (dd * dd >= DeltaZMin * DeltaZMin * vDelta);
  respostaAlta := (nObs >= 5) and (dr >= 0) and (dr * dr >= RespostaZMin * RespostaZMin * vRet);
  respostaBaixa := (nObs >= 5) and (dr <= 0) and (dr * dr >= RespostaZMin * RespostaZMin * vRet);

  vpinAlto := false;
  dv := 0;
  if vpin >= 0 then
  begin
    dv := vpin - mVpin;
    vpinAlto := (nVpin >= 5) and (dv >= 0) and (dv * dv >= VPINZMin * VPINZMin * vVpin);
  end;

  // ---------- 6. Atualiza estatisticas depois de usar (sem olhar o futuro) ----------
  alfa := 2.0 / (SpanEstatistica + 1.0);
  if barrasDia > 1 then
  begin
    if nObs = 0 then
    begin
      mDelta := delta;
      vDelta := 0;
      mRet := retorno;
      vRet := 0;
    end
    else
    begin
      mDelta := mDelta + alfa * dd;
      vDelta := (1.0 - alfa) * (vDelta + alfa * dd * dd);
      mRet := mRet + alfa * dr;
      vRet := (1.0 - alfa) * (vRet + alfa * dr * dr);
    end;
    nObs := nObs + 1;
  end;

  if vpin >= 0 then
  begin
    if nVpin = 0 then
    begin
      mVpin := vpin;
      vVpin := 0;
    end
    else
    begin
      mVpin := mVpin + alfa * dv;
      vVpin := (1.0 - alfa) * (vVpin + alfa * dv * dv);
    end;
    nVpin := nVpin + 1;
  end;

  // ---------- 7. Filtros de tendencia opcionais: MACD(12,26,9) e T3 ----------
  ema12 := ema12 + (2.0 / 13.0) * (Close - ema12);
  ema26 := ema26 + (2.0 / 27.0) * (Close - ema26);
  macdLinha := ema12 - ema26;
  macdSinal := macdSinal + (2.0 / 10.0) * (macdLinha - macdSinal);
  histMacd := macdLinha - macdSinal;

  k := 2.0 / (PeriodoT3 + 1.0);
  e1 := e1 + k * (Close - e1);
  e2 := e2 + k * (e1 - e2);
  e3 := e3 + k * (e2 - e3);
  e4 := e4 + k * (e3 - e4);
  e5 := e5 + k * (e4 - e5);
  e6 := e6 + k * (e5 - e6);
  a := FatorT3;
  c1 := -1.0 * a * a * a;
  c2 := 3.0 * a * a + 3.0 * a * a * a;
  c3 := -6.0 * a * a - 3.0 * a - 3.0 * a * a * a;
  c4 := 1.0 + 3.0 * a + a * a * a + 3.0 * a * a;
  t3 := c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3;

  // ---------- 8. Sinais de absorcao ----------
  // Compra: venda agressiva forte, mas o preco segurou ou subiu (compradores absorvendo).
  sinalCompra := deltaVendaForte and respostaAlta and vpinAlto;
  // Venda: compra agressiva forte, mas o preco segurou ou caiu (vendedores absorvendo).
  sinalVenda := deltaCompraForte and respostaBaixa and vpinAlto;
  if UsarTendencia then
  begin
    sinalCompra := sinalCompra and (histMacd >= 0) and (Close >= t3);
    sinalVenda := sinalVenda and (histMacd <= 0) and (Close <= t3);
  end;

  // ---------- 9. Gestao da posicao e entradas ----------
  if IsBought then
  begin
    entradaAtual := BuyPrice;
    stopAtual := entradaAtual - StopPontos;
    alvoAtual := entradaAtual + AlvoPontos;
    if Time >= HoraZeragem then
    begin
      SellToCoverAtMarket;
      saidaMercado := true;
    end
    else
    begin
      SellToCoverStop(stopAtual, stopAtual - FolgaStopPontos);
      SellToCoverLimit(alvoAtual);
    end;
  end
  else if IsSold then
  begin
    entradaAtual := SellPrice;
    stopAtual := entradaAtual + StopPontos;
    alvoAtual := entradaAtual - AlvoPontos;
    if Time >= HoraZeragem then
    begin
      BuyToCoverAtMarket;
      saidaMercado := true;
    end
    else
    begin
      BuyToCoverStop(stopAtual, stopAtual + FolgaStopPontos);
      BuyToCoverLimit(alvoAtual);
    end;
  end
  else
  begin
    saidaMercado := false;
    if (Time >= HoraInicio) and (Time < HoraUltimaEntrada) and (operacoesDia < MaxOperacoesDia)
       and (resultadoDia > -1.0 * PerdaMaxDiaReais) then
    begin
      if sinalCompra then
      begin
        BuyAtMarket;
        operacoesDia := operacoesDia + 1;
      end
      else if sinalVenda then
      begin
        SellShortAtMarket;
        operacoesDia := operacoesDia + 1;
      end;
    end;
  end;

  if IsBought then
    posAnterior := 1
  else if IsSold then
    posAnterior := -1
  else
    posAnterior := 0;
end;
