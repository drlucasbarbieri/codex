// =============================================================================
// ABSORCAO POR AGRESSAO + VPIN - NTSL (Editor de Estrategias do Profit) - v2
//
// Grafico recomendado: WIN (contrato atual), periodo de 1 minuto.
// Quantidade de contratos: defina na aba de execucao/automacao do Profit e
// repita o mesmo numero no parametro QtdContratos.
// Use primeiro em BACKTEST e depois no SIMULADOR antes de qualquer conta real.
//
// Ideia: agressao forte de um lado e o preco NAO cede = alguem esta absorvendo.
//   Compra: venda agressiva forte e o preco segurou ou subiu.
//   Venda : compra agressiva forte e o preco segurou ou caiu.
// O VPIN aproximado (desequilibrio da agressao sobre o volume agredido, media
// exponencial das ultimas barras do dia) precisa estar acima da propria media.
//
// v2: todas as variaveis tem prefixo (n, f, b) para nao coincidir com nomes de
// funcoes da NTSL (a v1 usava "delta", que e funcao de opcoes), e a sintaxe
// usa so o basico da linguagem.
// =============================================================================
input
  SpanEstatistica(100);     // barras das medias de referencia
  JanelaVPIN(30);           // barras do VPIN aproximado
  ForcaAgressaoMin(1.5);    // forca minima da agressao, em desvios (>= 0)
  RespostaPrecoMin(0.0);    // resposta minima do preco, em desvios (>= 0)
  ForcaVPINMin(0.5);        // VPIN acima da propria media, em desvios (>= 0)
  StopPontos(150);          // stop em pontos a partir da entrada
  AlvoPontos(225);          // alvo em pontos a partir da entrada
  FolgaStopPontos(50);      // folga do preco limite da ordem stop
  MaxOperacoesDia(4);
  PerdaMaxDiaReais(600.0);  // para de abrir operacoes ao estimar esta perda no dia
  ValorDoPonto(0.20);       // WIN: R$ 0,20 por ponto por contrato
  QtdContratos(1);          // so para a conta da perda do dia
  CustoPorContrato(5.5);    // corretagem + slippage estimado, ida e volta, em R$
  HoraInicio(905);
  HoraUltimaEntrada(1645);
  HoraZeragem(1700);
  UsarTendencia(0);         // 1 = exige MACD e T3 a favor; 0 = desligado
  PeriodoT3(5);
  FatorT3(0.7);

var
  nIniciado : Integer;
  nBarrasDia : Integer;
  nOperacoesDia : Integer;
  nPosAnterior : Integer;
  nPosAtual : Integer;
  nSaidaMercado : Integer;
  nObs : Integer;
  nObsVpin : Integer;
  nTemVpin : Integer;
  bVendaForte : Boolean;
  bCompraForte : Boolean;
  bPrecoSegurouAlta : Boolean;
  bPrecoSegurouBaixa : Boolean;
  bVpinAlto : Boolean;
  bSinalCompra : Boolean;
  bSinalVenda : Boolean;
  bPodeEntrar : Boolean;
  fDataAnterior : Float;
  fFechAnterior : Float;
  fResultadoDia : Float;
  fEntrada : Float;
  fStop : Float;
  fAlvo : Float;
  fSaida : Float;
  fAgrCompra : Float;
  fAgrVenda : Float;
  fSaldo : Float;
  fVariacao : Float;
  fDesb : Float;
  fDecai : Float;
  fSomaDesb : Float;
  fSomaVol : Float;
  fVpin : Float;
  fAlfa : Float;
  fMediaSaldo : Float;
  fVarSaldo : Float;
  fMediaVar : Float;
  fVarVar : Float;
  fMediaVpin : Float;
  fVarVpin : Float;
  fDifSaldo : Float;
  fDifVar : Float;
  fDifVpin : Float;
  fLimSaldo : Float;
  fLimVar : Float;
  fLimVpin : Float;
  fEma12 : Float;
  fEma26 : Float;
  fMacdLinha : Float;
  fMacdSinal : Float;
  fHistMacd : Float;
  fKT3 : Float;
  fFat : Float;
  fT3E1 : Float;
  fT3E2 : Float;
  fT3E3 : Float;
  fT3E4 : Float;
  fT3E5 : Float;
  fT3E6 : Float;
  fCoef1 : Float;
  fCoef2 : Float;
  fCoef3 : Float;
  fCoef4 : Float;
  fValorT3 : Float;

begin
  // ---------- 1. Primeira barra ----------
  if nIniciado = 0 then
  begin
    nIniciado := 1;
    fFechAnterior := Close;
    fEma12 := Close;
    fEma26 := Close;
    fT3E1 := Close;
    fT3E2 := Close;
    fT3E3 := Close;
    fT3E4 := Close;
    fT3E5 := Close;
    fT3E6 := Close;
  end;

  // ---------- 2. Troca de dia ----------
  if Date <> fDataAnterior then
  begin
    nBarrasDia := 0;
    nOperacoesDia := 0;
    fResultadoDia := 0;
    fSomaDesb := 0;
    fSomaVol := 0;
  end;
  fDataAnterior := Date;
  nBarrasDia := nBarrasDia + 1;

  // ---------- 3. Posicao atual: 0 = zerado, 1 = comprado, 2 = vendido ----------
  nPosAtual := 0;
  if IsBought then
    nPosAtual := 1;
  if IsSold then
    nPosAtual := 2;

  // ---------- 4. Resultado estimado da operacao encerrada nesta barra ----------
  if (nPosAnterior = 1) and (nPosAtual <> 1) then
  begin
    fSaida := Close;
    if nSaidaMercado = 1 then
      fSaida := Open
    else if Open <= fStop then
      fSaida := Open
    else if Low <= fStop then
      fSaida := fStop
    else if High >= fAlvo then
      fSaida := fAlvo;
    fResultadoDia := fResultadoDia + ((fSaida - fEntrada) * ValorDoPonto - CustoPorContrato) * QtdContratos;
  end;

  if (nPosAnterior = 2) and (nPosAtual <> 2) then
  begin
    fSaida := Close;
    if nSaidaMercado = 1 then
      fSaida := Open
    else if Open >= fStop then
      fSaida := Open
    else if High >= fStop then
      fSaida := fStop
    else if Low <= fAlvo then
      fSaida := fAlvo;
    fResultadoDia := fResultadoDia + ((fEntrada - fSaida) * ValorDoPonto - CustoPorContrato) * QtdContratos;
  end;

  // ---------- 5. Agressao da barra e variacao do preco ----------
  fAgrCompra := AgressionVolBuy;
  fAgrVenda := AgressionVolSell;
  fSaldo := fAgrCompra - fAgrVenda;
  fVariacao := Close - fFechAnterior;

  // ---------- 6. VPIN aproximado (recomeca a cada dia) ----------
  fDesb := fSaldo;
  if fDesb < 0 then
    fDesb := 0 - fDesb;
  fDecai := 1.0 - 2.0 / (JanelaVPIN + 1.0);
  fSomaDesb := fDecai * fSomaDesb + fDesb;
  fSomaVol := fDecai * fSomaVol + fAgrCompra + fAgrVenda;
  nTemVpin := 0;
  fVpin := 0;
  if (nBarrasDia >= JanelaVPIN) and (fSomaVol > 0) then
  begin
    fVpin := fSomaDesb / fSomaVol;
    nTemVpin := 1;
  end;

  // ---------- 7. Forca em relacao a media (compara quadrados, sem raiz) ----------
  fDifSaldo := fSaldo - fMediaSaldo;
  fDifVar := fVariacao - fMediaVar;
  fLimSaldo := ForcaAgressaoMin * ForcaAgressaoMin * fVarSaldo;
  fLimVar := RespostaPrecoMin * RespostaPrecoMin * fVarVar;
  bVendaForte := false;
  bCompraForte := false;
  bPrecoSegurouAlta := false;
  bPrecoSegurouBaixa := false;
  if (nObs >= 5) and (nBarrasDia > 1) then
  begin
    if (fDifSaldo < 0) and (fDifSaldo * fDifSaldo >= fLimSaldo) then
      bVendaForte := true;
    if (fDifSaldo > 0) and (fDifSaldo * fDifSaldo >= fLimSaldo) then
      bCompraForte := true;
    if (fDifVar >= 0) and (fDifVar * fDifVar >= fLimVar) then
      bPrecoSegurouAlta := true;
    if (fDifVar <= 0) and (fDifVar * fDifVar >= fLimVar) then
      bPrecoSegurouBaixa := true;
  end;

  bVpinAlto := false;
  fDifVpin := 0;
  if nTemVpin = 1 then
  begin
    fDifVpin := fVpin - fMediaVpin;
    fLimVpin := ForcaVPINMin * ForcaVPINMin * fVarVpin;
    if (nObsVpin >= 5) and (fDifVpin >= 0) and (fDifVpin * fDifVpin >= fLimVpin) then
      bVpinAlto := true;
  end;

  // ---------- 8. Atualiza as medias depois de usar (sem olhar o futuro) ----------
  fAlfa := 2.0 / (SpanEstatistica + 1.0);
  if nBarrasDia > 1 then
  begin
    if nObs = 0 then
    begin
      fMediaSaldo := fSaldo;
      fVarSaldo := 0;
      fMediaVar := fVariacao;
      fVarVar := 0;
    end
    else
    begin
      fMediaSaldo := fMediaSaldo + fAlfa * fDifSaldo;
      fVarSaldo := (1.0 - fAlfa) * (fVarSaldo + fAlfa * fDifSaldo * fDifSaldo);
      fMediaVar := fMediaVar + fAlfa * fDifVar;
      fVarVar := (1.0 - fAlfa) * (fVarVar + fAlfa * fDifVar * fDifVar);
    end;
    nObs := nObs + 1;
  end;

  if nTemVpin = 1 then
  begin
    if nObsVpin = 0 then
    begin
      fMediaVpin := fVpin;
      fVarVpin := 0;
    end
    else
    begin
      fMediaVpin := fMediaVpin + fAlfa * fDifVpin;
      fVarVpin := (1.0 - fAlfa) * (fVarVpin + fAlfa * fDifVpin * fDifVpin);
    end;
    nObsVpin := nObsVpin + 1;
  end;

  // ---------- 9. Filtro de tendencia opcional: MACD(12,26,9) e T3 ----------
  fEma12 := fEma12 + (2.0 / 13.0) * (Close - fEma12);
  fEma26 := fEma26 + (2.0 / 27.0) * (Close - fEma26);
  fMacdLinha := fEma12 - fEma26;
  fMacdSinal := fMacdSinal + (2.0 / 10.0) * (fMacdLinha - fMacdSinal);
  fHistMacd := fMacdLinha - fMacdSinal;

  fKT3 := 2.0 / (PeriodoT3 + 1.0);
  fT3E1 := fT3E1 + fKT3 * (Close - fT3E1);
  fT3E2 := fT3E2 + fKT3 * (fT3E1 - fT3E2);
  fT3E3 := fT3E3 + fKT3 * (fT3E2 - fT3E3);
  fT3E4 := fT3E4 + fKT3 * (fT3E3 - fT3E4);
  fT3E5 := fT3E5 + fKT3 * (fT3E4 - fT3E5);
  fT3E6 := fT3E6 + fKT3 * (fT3E5 - fT3E6);
  fFat := FatorT3;
  fCoef1 := 0 - fFat * fFat * fFat;
  fCoef2 := 3.0 * fFat * fFat + 3.0 * fFat * fFat * fFat;
  fCoef3 := 0 - 6.0 * fFat * fFat - 3.0 * fFat - 3.0 * fFat * fFat * fFat;
  fCoef4 := 1.0 + 3.0 * fFat + fFat * fFat * fFat + 3.0 * fFat * fFat;
  fValorT3 := fCoef1 * fT3E6 + fCoef2 * fT3E5 + fCoef3 * fT3E4 + fCoef4 * fT3E3;

  // ---------- 10. Sinais de absorcao ----------
  bSinalCompra := false;
  bSinalVenda := false;
  if bVendaForte and bPrecoSegurouAlta and bVpinAlto then
    bSinalCompra := true;
  if bCompraForte and bPrecoSegurouBaixa and bVpinAlto then
    bSinalVenda := true;
  if UsarTendencia = 1 then
  begin
    if (fHistMacd < 0) or (Close < fValorT3) then
      bSinalCompra := false;
    if (fHistMacd > 0) or (Close > fValorT3) then
      bSinalVenda := false;
  end;

  // ---------- 11. Posicao comprada: stop, alvo e zeragem ----------
  if nPosAtual = 1 then
  begin
    fEntrada := BuyPrice;
    fStop := fEntrada - StopPontos;
    fAlvo := fEntrada + AlvoPontos;
    if Time >= HoraZeragem then
    begin
      SellToCoverAtMarket;
      nSaidaMercado := 1;
    end
    else
    begin
      SellToCoverStop(fStop, fStop - FolgaStopPontos);
      SellToCoverLimit(fAlvo);
    end;
  end;

  // ---------- 12. Posicao vendida: stop, alvo e zeragem ----------
  if nPosAtual = 2 then
  begin
    fEntrada := SellPrice;
    fStop := fEntrada + StopPontos;
    fAlvo := fEntrada - AlvoPontos;
    if Time >= HoraZeragem then
    begin
      BuyToCoverAtMarket;
      nSaidaMercado := 1;
    end
    else
    begin
      BuyToCoverStop(fStop, fStop + FolgaStopPontos);
      BuyToCoverLimit(fAlvo);
    end;
  end;

  // ---------- 13. Zerado: entradas ----------
  if nPosAtual = 0 then
  begin
    nSaidaMercado := 0;
    bPodeEntrar := false;
    if (Time >= HoraInicio) and (Time < HoraUltimaEntrada) then
      bPodeEntrar := true;
    if nOperacoesDia >= MaxOperacoesDia then
      bPodeEntrar := false;
    if fResultadoDia + PerdaMaxDiaReais <= 0 then
      bPodeEntrar := false;
    if bPodeEntrar then
    begin
      if bSinalCompra then
      begin
        BuyAtMarket;
        nOperacoesDia := nOperacoesDia + 1;
      end
      else if bSinalVenda then
      begin
        SellShortAtMarket;
        nOperacoesDia := nOperacoesDia + 1;
      end;
    end;
  end;

  nPosAnterior := nPosAtual;
  fFechAnterior := Close;
end;
